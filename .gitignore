# ==============================================================================
# FitLife Gym Management System — Git Ignore Rules
# ==============================================================================

# ─── Environment & Sensitive Credentials ─────────────────────────────────────
config/settings.json
.env
.env.*
!.env.example

# ─── Python Bytecode & Cache ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version

# ─── Virtual Environments ─────────────────────────────────────────────────────
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ─── Databases & Storage Locks ────────────────────────────────────────────────
database/fitlife.db
database/test_fitlife.db
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ─── Generated Reports & Exports (Preserve Folder via .gitkeep) ───────────────
reports/*
!reports/.gitkeep

# ─── Application Logs (Preserve Folder via .gitkeep) ──────────────────────────
logs/*
!logs/.gitkeep

# ─── Uploaded Assets & Media ─────────────────────────────────────────────────
assets/images/photos/*
!assets/images/photos/.gitkeep

# ─── IDE & Editor Settings ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ─── Operating System Metadata ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.stackdump

# ─── Packaging & Build Artifacts ──────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
*.spec
*.exe

# ─── Testing, Linting & Coverage Artifacts ───────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
verify_all.py
